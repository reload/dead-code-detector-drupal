# No library paths or settings from this checkout's Composer data.
services:
    drupalDeadCode.libraryPaths:
        factory: Reload\DeadCodeDetectorDrupal\Support\LibraryCode\LibraryPaths::fromDirectories([])
    drupalDeadCode.settingsFiles:
        factory: Reload\DeadCodeDetectorDrupal\Support\Discovery\SettingsFiles([])

# Transitively dead members are otherwise only mentioned in tips.
parameters:
    shipmonkDeadCode:
        reportTransitivelyDeadMethodAsSeparateError: true
        # Offloading collector data to disk serves large analyses; the cache's
        # garbage collection deletes what parallel test processes still need.
        cache:
            offloadCollectorData: false
