{
    "name": "reload/dead-code-detector-drupal",
    "description": "Drupal support for shipmonk/dead-code-detector: usage providers that teach it how Drupal calls code.",
    "license": "MIT",
    "type": "phpstan-extension",
    "keywords": [
        "drupal",
        "phpstan",
        "dead code",
        "unused code"
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "mglaman/phpstan-drupal": "^2.0",
        "phpstan/phpstan": "^2.1.41",
        "shipmonk/dead-code-detector": "^1.4",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "drupal/core": "^11.3 || ^12",
        "infection/infection": "^0.35.6",
        "phpat/phpat": "^0.12.5",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0",
        "shipmonk/phpstan-rules": "^4.4",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Reload\\DeadCodeDetectorDrupal\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": false,
            "drupal/core-composer-scaffold": false,
            "infection/extension-installer": false,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
