parameters:
    drupalDeadCode:
        twigTemplates:
            enabled: true
        testsExcluder:
            enabled: true

parametersSchema:
    drupalDeadCode: structure([
        twigTemplates: structure([
            enabled: bool()
        ])
        testsExcluder: structure([
            enabled: bool()
        ])
    ])

services:
    drupalDeadCode.drupalFiles:
        type: Reload\DeadCodeDetectorDrupal\Support\Discovery\DrupalFiles
        factory: Reload\DeadCodeDetectorDrupal\Support\Discovery\DrupalFiles(
            %analysedPaths%,
            Reload\DeadCodeDetectorDrupal\Support\Discovery\ExcludedPaths::fromParameter(%excludePaths%),
            %drupalDeadCode.twigTemplates.enabled%
        )

    drupalDeadCode.settingsFiles:
        type: Reload\DeadCodeDetectorDrupal\Support\Discovery\SettingsFiles
        factory: Reload\DeadCodeDetectorDrupal\Support\Discovery\SettingsFiles::find(%drupalDeadCode.twigTemplates.enabled%)

    -
        class: Reload\DeadCodeDetectorDrupal\Support\Discovery\DrupalFilesResultCacheMetaExtension
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles
            settingsFiles: @drupalDeadCode.settingsFiles
        tags:
            - phpstan.resultCacheMetaExtension

    drupalDeadCode.libraryPaths:
        type: Reload\DeadCodeDetectorDrupal\Support\LibraryCode\LibraryPaths
        factory: Reload\DeadCodeDetectorDrupal\Support\LibraryCode\LibraryPaths::read()

    -
        class: Reload\DeadCodeDetectorDrupal\Support\LibraryCode\LibraryCodeUsageProvider
        arguments:
            libraryPaths: @drupalDeadCode.libraryPaths
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.originFiles:
        class: Reload\DeadCodeDetectorDrupal\Support\Usage\OriginFiles

    drupalDeadCode.serviceDefinitions:
        class: Reload\DeadCodeDetectorDrupal\Core\Services\ServiceDefinitions
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Services\ServiceUsageProvider
        arguments:
            services: @drupalDeadCode.serviceDefinitions
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.routeDefinitions:
        class: Reload\DeadCodeDetectorDrupal\Core\Routing\RouteDefinitions
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles
            services: @drupalDeadCode.serviceDefinitions

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Routing\RouteUsageProvider
        arguments:
            routes: @drupalDeadCode.routeDefinitions
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Routing\RouteAttributeUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.schemaCallbacks:
        class: Reload\DeadCodeDetectorDrupal\Core\ConfigSchema\SchemaCallbacks
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles

    -
        class: Reload\DeadCodeDetectorDrupal\Core\ConfigSchema\SchemaCallbackUsageProvider
        arguments:
            callbacks: @drupalDeadCode.schemaCallbacks
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.permissionCallbacks:
        class: Reload\DeadCodeDetectorDrupal\Core\Permission\PermissionCallbacks
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles
            services: @drupalDeadCode.serviceDefinitions

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Permission\PermissionCallbackUsageProvider
        arguments:
            callbacks: @drupalDeadCode.permissionCallbacks
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Hook\HookUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\ConfigAction\ActionMethodUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Callable\StringCallableUsageProvider
        arguments:
            services: @drupalDeadCode.serviceDefinitions
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Rest\RestResourceUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Contrib\GraphQl\GraphQlDataProducerUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Contrib\JsonApi\JsonApiResourceUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Access\AccessCheckerUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\EventSubscriber\HttpExceptionHandlerUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\ConfigEntity\ConfigEntityPropertyUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Plugin\PluginAttributePropertyUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Validation\ConstraintPropertyUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    -
        class: Reload\DeadCodeDetectorDrupal\Contrib\Drush\DrushUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.settingLists:
        class: Reload\DeadCodeDetectorDrupal\Core\Settings\SettingLists
        arguments:
            settingsFiles: @drupalDeadCode.settingsFiles

    drupalDeadCode.templates:
        class: Reload\DeadCodeDetectorDrupal\Core\Twig\TwigTemplates
        arguments:
            drupalFiles: @drupalDeadCode.drupalFiles

    drupalDeadCode.twigSandbox:
        class: Reload\DeadCodeDetectorDrupal\Core\Twig\TwigSandbox
        arguments:
            settingLists: @drupalDeadCode.settingLists

    -
        class: Reload\DeadCodeDetectorDrupal\Core\Twig\TwigUsageProvider
        arguments:
            templates: @drupalDeadCode.templates
            sandbox: @drupalDeadCode.twigSandbox
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageProvider

    drupalDeadCode.testPaths:
        type: Reload\DeadCodeDetectorDrupal\Core\TestCode\TestPaths
        factory: Reload\DeadCodeDetectorDrupal\Core\TestCode\TestPaths(%analysedPaths%)

    -
        class: Reload\DeadCodeDetectorDrupal\Core\TestCode\TestsUsageExcluder
        arguments:
            enabled: %drupalDeadCode.testsExcluder.enabled%
            testPaths: @drupalDeadCode.testPaths
            originFiles: @drupalDeadCode.originFiles
        tags:
            - shipmonk.deadCode.memberUsageExcluder
